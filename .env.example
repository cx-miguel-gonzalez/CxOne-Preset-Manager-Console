# Copy this file to .env and fill in your tenant details.
# .env is gitignored -- never commit real credentials.

CX_TENANT=my-tenant
CX_BASE_URL=https://ast.checkmarx.net
CX_IAM_URL=https://iam.checkmarx.net

# auth_method is optional; inferred as api_key if CX_API_KEY is set,
# otherwise client_credentials if both CX_CLIENT_ID and CX_CLIENT_SECRET are set.
# CX_AUTH_METHOD=api_key

# Option A: API Key
CX_API_KEY=

# Option B: Client ID / Client Secret
CX_CLIENT_ID=
CX_CLIENT_SECRET=

# Optional: fixes the Flask session signing key across restarts.
# FLASK_SECRET_KEY=
